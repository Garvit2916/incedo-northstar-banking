# Copy to `.env.local` to override build/dev-time frontend settings.

# Base URL for API calls. Leave empty in development (the Vite dev server and
# the nginx container both proxy /api and /health to the backend).
# VITE_API_BASE_URL=

# Set to "true" to show the seeded demo logins (fake accounts, e.g.
# customer@northstar.example) on the sign-in page. This is a development
# convenience only: never enable it for a build that will be served publicly.
VITE_ENABLE_DEMO_ACCOUNTS=false
