{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=northstar.db"
  },
  "Jwt": {
    "Issuer": "northstar",
    "Audience": "northstar-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Storage": {
    "Provider": "Local",
    "LocalRootPath": "App_Data/kyc",
    "AzureContainerName": "kyc-documents"
  },
  "Email": {
    "Provider": "Noop",
    "FromAddress": "no-reply@northstar.example",
    "FromName": "Northstar Banking"
  },
  "Ai": {
    "Provider": "deterministic",
    "Model": "gpt-4o-mini",
    "TimeoutSeconds": 20,
    "MaxInputCharacters": 12000,
    "Temperature": 0.2
  },
  "FileUpload": {
    "MaxFileSizeBytes": 5242880,
    "AllowedExtensions": [ ".pdf", ".jpg", ".jpeg", ".png" ],
    "AllowedContentTypes": [ "application/pdf", "image/jpeg", "image/png" ]
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "RateLimiting": {
    "Auth": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Ai": { "PermitLimit": 30, "WindowSeconds": 60 },
    "Uploads": { "PermitLimit": 20, "WindowSeconds": 300 }
  },
  "Seed": {
    "Enabled": true
  }
}
